    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "ws": "^8.23.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
