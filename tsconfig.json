{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@belot/game-engine": ["./packages/game-engine/src/index.ts"],
      "@belot/bots": ["./packages/bots/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "*.config.ts"]
}
